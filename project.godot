; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Silas Crowe: Shadow & Rain"
config/description="2D pixel art noir dedektiflik oyunu"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

AssetManager="*res://scripts/autoload/asset_manager.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
InputManager="*res://scripts/autoload/input_manager.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
CutsceneManager="*res://scripts/autoload/cutscene_manager.gd"
LocalizationManager="*res://scripts/autoload/localization_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/initial_position_type=2
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[gui]

theme/custom="res://resources/noir_theme.tres"
theme/custom_font="res://assets/fonts/CourierPrime-Regular.ttf"

