theme_override_colors/font_color = Color(0.85, 0.88, 0.92, 1)
theme_override_font_sizes/font_size = 6
text = "Kara Vadi malikânesinde işlenen gizemli cinayet, dedektif Silas Crowe'un keskin dikkatiyle son buldu. Aile hekimi Dr. Victor Hale, cinayeti kaza gibi göstermek istese de geride bıraktığı digitalis izleri ve kütüphanedeki soğuk şömine delilini yerle bir etti. Silas Crowe'un soruşturması şafak vakti polis ekiplerinin malikâneye ulaşmasıyla tamamlandı."
autowrap_mode = 2

